{
  "kind": "collectionType",
  "collectionName": "memories",
  "info": {
    "singularName": "memory",
    "pluralName": "memories",
    "displayName": "Memories",
    "description": "Shared agent memory (research, scripts, media, project context). Always scoped to one headquarters."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "kind": {
      "type": "enumeration",
      "required": true,
      "default": "note",
      "enum": [
        "research",
        "script",
        "voice",
        "media",
        "video",
        "publish",
        "context",
        "note"
      ]
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "content": {
      "type": "text",
      "required": true
    },
    "data": {
      "type": "json"
    },
    "tags": {
      "type": "json"
    },
    "headquarter": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::headquarter.headquarter"
    },
    "agent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::agent.agent"
    },
    "task": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::agent-task.agent-task"
    }
  }
}
