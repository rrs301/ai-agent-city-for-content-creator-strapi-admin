{
  "kind": "collectionType",
  "collectionName": "media_assets",
  "info": {
    "singularName": "media-asset",
    "pluralName": "media-assets",
    "displayName": "Media Assets",
    "description": "Images generated or transformed by Creator City agents with ImageKit AI. The file lives in the media library (ImageKit). Always scoped to one headquarters."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "operation": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "text_to_image",
        "remove_background",
        "change_background",
        "edit",
        "generative_fill",
        "drop_shadow",
        "retouch",
        "upscale",
        "variation",
        "smart_crop"
      ]
    },
    "provider": {
      "type": "enumeration",
      "required": true,
      "default": "imagekit",
      "enum": ["imagekit", "openai"]
    },
    "purpose": {
      "type": "enumeration",
      "default": "graphic",
      "enum": ["thumbnail", "scene", "graphic", "product", "social", "other"]
    },
    "prompt": {
      "type": "text"
    },
    "transformation": {
      "type": "text"
    },
    "sourceUrl": {
      "type": "text"
    },
    "url": {
      "type": "text",
      "required": true
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "file": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "source": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::media-asset.media-asset"
    },
    "headquarter": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::headquarter.headquarter"
    },
    "agent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::agent.agent"
    },
    "task": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::agent-task.agent-task"
    }
  }
}
