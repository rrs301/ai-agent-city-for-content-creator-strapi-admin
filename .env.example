HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Creator City agent memory (MCP). Must match MEMORY_SCOPE_SECRET in the Next.js app; at least 32 characters.
# Generate with: openssl rand -hex 32
MEMORY_SCOPE_SECRET=tobemodified

# ImageKit media (strapi-plugin-imagekit). Keys: https://imagekit.io/dashboard/developer/api-keys
# These seed the plugin settings on first run; afterwards the admin UI (Settings > ImageKit) values in the DB take precedence.
IMAGEKIT_PUBLIC_KEY=public_xxx
IMAGEKIT_PRIVATE_KEY=private_xxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_UPLOAD_FOLDER=/creators-city/
